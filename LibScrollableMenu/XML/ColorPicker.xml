<!--
  #2026_21 Color picker (LAM/ZOS keyboard layout, not COLOR_PICKER dialog) - idea Dakjaniels (addon: LibScrollableMenu)
-->
<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
  <Controls>
    <TopLevelControl name="LibScrollableMenu_ColorPicker_TLC" clampedToScreen="true" resizeToFitDescendents="true" hidden="true" mouseEnabled="true" movable="true">
      <DimensionConstraints minX="0" maxX="400" minY="0" maxY="320"/>
    </TopLevelControl>

    <Control name="LibScrollableMenu_ColorPickerPanel"
             virtual="true"
             hidden="true"
             mouseEnabled="true"
             movable="true"
             clampedToScreen="true"
             tier="HIGH"
             level="10">
      <Dimensions x="400"
                  y="320" />
      <Controls>
        <Backdrop name="$(parent)BG"
                  layer="CONTROLS"
                  tier="LOW"
                  inherits="ZO_DefaultBackdrop"
                  excludeFromResizeToFitExtents="true">
          <AnchorFill />
        </Backdrop>
        <Button name="$(parent)Close"
                inherits="ZO_CloseButton"
                level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL"
                excludeFromResizeToFitExtents="true">
          <Anchor point="TOPRIGHT"
                  offsetX="-5"
                  offsetY="5" />
        </Button>
        <Label name="$(parent)Title"
               font="ZoFontWinH3"
               color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"
               modifyTextType="UPPERCASE"
               mouseEnabled="true"
               movable="true">
          <Anchor point="TOPLEFT"
                  offsetX="12"
                  offsetY="8" />
          <Anchor point="TOPRIGHT"
                  relativeTo="$(parent)Close"
                  relativePoint="TOPLEFT"
                  offsetX="-8"
                  offsetY="2" />
        </Label>
        <Control name="$(parent)Content">
          <Anchor point="TOPLEFT"
                  offsetX="12"
                  offsetY="36" />
          <Anchor point="BOTTOMRIGHT"
                  offsetX="-12"
                  offsetY="-46" />
          <Controls>
            <ColorSelect name="$(parent)ColorSelect"
                         mouseEnabled="true"
                         level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
              <Anchor point="TOP"
                      offsetY="24" />
              <Dimensions x="128"
                          y="128" />
              <Controls>
                <Texture name="$(parent)Thumb"
                         textureFile="EsoUI/Art/Miscellaneous/colorPicker_pip.dds"
                         excludeFromResizeToFitExtents="true"
                         pixelRoundingEnabled="false"
                         layer="2">
                  <Dimensions x="32"
                              y="32" />
                </Texture>
              </Controls>
            </ColorSelect>
            <Control name="$(parent)Preview">
              <Dimensions x="64"
                          y="64" />
              <Anchor point="RIGHT"
                      relativeTo="$(parent)ColorSelect"
                      relativePoint="LEFT"
                      offsetX="-25" />
              <Controls>
                <Texture name="$(parent)Border"
                         textureFile="EsoUI/Art/Miscellaneous/colorPicker_swatchFrame.dds">
                  <Anchor point="CENTER" />
                  <Dimensions x="64"
                              y="64" />
                </Texture>
                <Texture name="$(parent)TextureTop"
                         layer="OVERLAY">
                  <Anchor point="TOP"
                          offsetY="3" />
                  <Dimensions x="58"
                              y="29" />
                </Texture>
                <Label name="$(parent)TopLabel"
                       font="ZoFontWinH4"
                       color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"
                       modifyTextType="UPPERCASE"
                       text="SI_COLOR_PICKER_NEW">
                  <Anchor point="BOTTOM"
                          relativeTo="$(parent)TextureTop"
                          relativePoint="TOP"
                          offsetY="-5" />
                </Label>
                <Texture name="$(parent)TextureBottom"
                         layer="OVERLAY">
                  <Anchor point="BOTTOM"
                          offsetY="-3" />
                  <Dimensions x="58"
                              y="29" />
                </Texture>
                <Label name="$(parent)BottomLabel"
                       font="ZoFontWinH4"
                       color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"
                       modifyTextType="UPPERCASE"
                       text="SI_COLOR_PICKER_CURRENT">
                  <Anchor point="TOP"
                          relativeTo="$(parent)TextureBottom"
                          relativePoint="BOTTOM"
                          offsetY="5" />
                </Label>
              </Controls>
            </Control>
            <Slider name="$(parent)Value"
                    dragFromThumb="false"
                    tier="HIGH"
                    mouseEnabled="true"
                    level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
              <Anchor point="LEFT"
                      relativeTo="$(parent)ColorSelect"
                      relativePoint="RIGHT"
                      offsetX="35" />
              <Dimensions x="22"
                          y="122" />
              <Limits min="0"
                      max="1" />
              <ThumbTexture textureFile="EsoUI/Art/Miscellaneous/colorPicker_slider_vertical.dds"
                            thumbWidth="64"
                            thumbHeight="32"
                            flushWithSliderExtents="false" />
              <Controls>
                <Texture name="$(parent)Texture">
                  <Dimensions x="22"
                              y="128" />
                  <Anchor point="CENTER" />
                </Texture>
                <Texture name="$(parent)Background"
                         textureFile="EsoUI/Art/Miscellaneous/colorPicker_sliderFrame.dds">
                  <TextureCoords left="0"
                                 right="0.6875"
                                 top="0"
                                 bottom="1" />
                  <Dimensions x="22"
                              y="128" />
                  <Anchor point="CENTER" />
                </Texture>
              </Controls>
            </Slider>
            <Slider name="$(parent)Alpha"
                    dragFromThumb="false"
                    tier="HIGH"
                    orientation="HORIZONTAL"
                    mouseEnabled="true"
                    level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
              <Anchor point="TOP"
                      relativeTo="$(parent)ColorSelect"
                      relativePoint="BOTTOM"
                      offsetY="15" />
              <Dimensions x="122"
                          y="22" />
              <Limits min="0"
                      max="1" />
              <ThumbTexture textureFile="EsoUI/Art/Miscellaneous/colorPicker_slider_vertical.dds"
                            thumbWidth="64"
                            thumbHeight="32"
                            flushWithSliderExtents="false" />
              <Controls>
                <Texture name="$(parent)Texture">
                  <Dimensions x="128"
                              y="22" />
                  <Anchor point="CENTER" />
                </Texture>
                <Texture name="$(parent)Background"
                         textureFile="EsoUI/Art/Miscellaneous/colorPicker_sliderFrame.dds">
                  <TextureCoords left="0"
                                 right="0.6875"
                                 top="0"
                                 bottom="1" />
                  <Dimensions x="22"
                              y="128" />
                  <Anchor point="CENTER" />
                  <OnInitialized>
                    self:SetTextureRotation(ZO_HALF_PI)
                  </OnInitialized>
                </Texture>
              </Controls>
            </Slider>
            <Label name="$(parent)AlphaLabel"
                   font="ZoFontWinH4"
                   color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED"
                   horizontalAlignment="RIGHT"
                   modifyTextType="UPPERCASE"
                   text="SI_COLOR_PICKER_ALPHA">
              <Anchor point="TOPRIGHT"
                      relativeTo="$(parent)Alpha"
                      relativePoint="TOPLEFT"
                      offsetX="-10" />
            </Label>
            <Control name="$(parent)Spinners"
                     resizeToFitDescendents="true">
              <Anchor point="BOTTOM" />
              <Controls>
                <Control name="$(parent)Red"
                         inherits="ZO_EditSpinner"
                         level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
                  <Anchor point="LEFT" />
                </Control>
                <Control name="$(parent)Green"
                         inherits="ZO_EditSpinner"
                         level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)Red"
                          relativePoint="RIGHT"
                          offsetX="10" />
                </Control>
                <Control name="$(parent)Blue"
                         inherits="ZO_EditSpinner"
                         level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)Green"
                          relativePoint="RIGHT"
                          offsetX="10" />
                </Control>
                <Control name="$(parent)Alpha"
                         inherits="ZO_EditSpinner"
                         level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
                  <Anchor point="LEFT"
                          relativeTo="$(parent)Blue"
                          relativePoint="RIGHT"
                          offsetX="10" />
                </Control>
              </Controls>
            </Control>
          </Controls>
        </Control>
        <Button name="$(parent)Reset"
                inherits="ZO_DefaultTextButton"
                level="ZO_HUD_EDITOR_KEYBOARD_INFO_BOX_INTERACTABLE_ELEMENT_LEVEL">
          <Anchor point="BOTTOM"
                  offsetY="-10" />
        </Button>
      </Controls>
    </Control>
  </Controls>
</GuiXml>